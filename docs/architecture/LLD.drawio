                <mxCell id="le-6" value="all link ops" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-ctrl" target="lk-svc">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-7" value="status / dest / delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-svc" target="lk-own">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-8" value="save / list / owned get" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-svc" target="lk-repo">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-9" value="findByIdAndOwnerId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-own" target="lk-repo">
                    <mxGeometry relative="1" as="geometry"/>
