    <diagram id="components" name="2 - Component Interactions">
        <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1680" math="0" shadow="0">
            <root>
                <mxCell id="cmp0"/>
                <mxCell id="cmp1" parent="cmp0"/>
                <mxCell id="cmp-title" value="TinyRoute LLD — Which component talks to which (labeled calls)" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="cmp1">
                    <mxGeometry x="320" y="12" width="1400" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="cmp-legend" value="Solid arrow = synchronous call on the request path. Dashed arrow = async / must not block. Next.js is an HTTP client only: it never calls PostgreSQL, Redis, repositories, OwnershipGuard, or RedirectService." style="text;html=1;fontSize=12;align=center;" vertex="1" parent="cmp1">
                    <mxGeometry x="80" y="48" width="2320" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="lane-red" value="Public redirect" style="swimlane;html=1;horizontal=1;startSize=32;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="cmp1">
                    <mxGeometry x="40" y="90" width="580" height="1320" as="geometry"/>
                </mxCell>
                <mxCell id="red-vis" value="Visitor browser" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="50" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="red-ing" value="HTTPS ingress — TLS; route GET /{code}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="130" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="red-ctrl" value="RedirectController&#10;No session, no CSRF, no ownership" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="210" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="red-rl" value="RateLimitService.allowRedirect(clientHash)&#10;→ RateLimitStore INCR rl:redirect:{clientHash}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="302" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="red-svc" value="RedirectService.resolve(code)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="394" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="red-cache" value="RedirectCache.get / put&#10;key redirect:{code}  TTL ≤5s  malformed = miss" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="474" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="red-repo" value="LinkRepository.findByCode (cache miss only)&#10;case-sensitive; fail closed if query errors" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="566" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="red-click" value="ClickCountService.recordSuccessfulRedirect&#10;after 3xx only; failure ignored" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="658" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="red-redis" value="Redis — redirect cache + rl:redirect counter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="750" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="red-pg" value="PostgreSQL — links row (system of record)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="830" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="red-note" value="Does not call: AuthService, LinkService, SessionStore, OwnershipGuard, UserRepository, Next.js. ClickCountService does not call RedirectCache." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=12;" vertex="1" parent="lane-red">
                    <mxGeometry x="40" y="900" width="500" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="re-1" value="GET /{code}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-red" source="red-vis" target="red-ing">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re-2" value="forward, no cookie required" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-red" source="red-ing" target="red-ctrl">
                    <mxGeometry relative="1" as="geometry"/>
