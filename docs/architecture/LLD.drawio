                    <mxGeometry x="1010" y="1680" width="600" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="InvariantNote" value="Core invariants: codes are unique, case-sensitive, tombstoned, and never reused (FR-CRE-04, FR-RED-05/06, FR-MGT-05); manage queries include owner_id (FR-MGT-01..05/07, NFR-SEC-04); only known ACTIVE + destination redirects (FR-RED-01..04, NFR-REL-01/02); DB commit precedes cache eviction and cache TTL is ≤5 s (NFR-CON-01/02)." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="c1">
