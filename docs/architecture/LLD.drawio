                <mxCell id="scope-note" value="Next.js is an HTTP client only. Controllers translate HTTP and cookies; services own policy and transactions; AuthProvider/OtpSender are map strategies; repositories/adapters own persistence." style="text;html=1;fontSize=12;align=center;fillColor=none;strokeColor=none;fontColor=#000000;" vertex="1" parent="c1">
