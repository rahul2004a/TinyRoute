                </mxCell>
                <mxCell id="JpaAuthIdentityRepository" value="&lt;b&gt;[C] JpaAuthIdentityRepository&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;- entityManager: EntityManager&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ save(identity: AuthIdentity): AuthIdentity&lt;br&gt;+ findByProviderAndSubject(...): AuthIdentity?&lt;br&gt;+ findAllByUserId(userId: UUID): List&amp;lt;AuthIdentity&amp;gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fillColor=#000000;fontColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="c1">
