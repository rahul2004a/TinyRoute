                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re-5" value="cache-aside get/put" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-red" source="red-svc" target="red-cache">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re-6" value="miss / Redis down" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-red" source="red-svc" target="red-repo">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
