                <mxCell id="c-links" value="&lt;b&gt;LinkController&lt;/b&gt;&lt;br&gt;POST/GET /api/links&lt;br&gt;PATCH status • DELETE&lt;br&gt;Authenticated owner only&lt;br&gt;FR-CRE-* • FR-MGT-*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="360" y="425" width="210" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="c-health" value="&lt;b&gt;HealthController&lt;/b&gt;&lt;br&gt;GET /actuator/health&lt;br&gt;App + PostgreSQL reachability&lt;br&gt;NFR-AVL-02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="360" y="600" width="210" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c-security" value="&lt;b&gt;Spring Security filter chain&lt;/b&gt;&lt;br&gt;Opaque session cookie&lt;br&gt;HttpOnly • Secure • SameSite&lt;br&gt;CSRF for mutating browser requests&lt;br&gt;Safe error mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="620" y="120" width="230" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="c-rate" value="&lt;b&gt;RateLimitService&lt;/b&gt;&lt;br&gt;Auth: client key&lt;br&gt;Create: account key&lt;br&gt;Redirect: client/code key&lt;br&gt;Redis atomic counters + TTL&lt;br&gt;FR-ABS-01..03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="620" y="300" width="230" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c-redirectsvc" value="&lt;b&gt;RedirectService&lt;/b&gt;&lt;br&gt;Cache-aside lookup&lt;br&gt;ACTIVE → redirect&lt;br&gt;DISABLED/DELETED/UNKNOWN → no redirect&lt;br&gt;Datastore uncertainty → fail closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#2b8a3e;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="80" width="260" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="c-authsvc" value="&lt;b&gt;AuthService&lt;/b&gt;&lt;br&gt;Normalize email&lt;br&gt;Argon2id/bcrypt password hash&lt;br&gt;Create/revoke 30-day idle session&lt;br&gt;NFR-SEC-02,06" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#2b8a3e;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="270" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="c-linksvc" value="&lt;b&gt;LinkService&lt;/b&gt;&lt;br&gt;Validate HTTPS + reject self-reference&lt;br&gt;Generate random code; retry unique conflict&lt;br&gt;Check owner on every operation&lt;br&gt;Status transitions + cache eviction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#2b8a3e;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="450" width="260" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="c-repos" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;UserRepository&lt;br&gt;LinkRepository&lt;br&gt;Parameterized JPA queries&lt;br&gt;Versioned Flyway/Liquibase migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="345" width="220" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="c-redis" value="&lt;b&gt;Redis adapters&lt;/b&gt;&lt;br&gt;RedirectCache&lt;br&gt;SessionRepository&lt;br&gt;RateLimitRepository&lt;br&gt;Cache records encode link state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="120" width="220" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="c-cross" value="&lt;b&gt;Cross-cutting&lt;/b&gt;&lt;br&gt;Bean validation • transaction boundaries • idempotent lifecycle commands&lt;br&gt;structured request logs method/path/status/duration • correlation ID • no secrets&lt;br&gt;NFR-REL-03 • NFR-OBS-01 • NFR-SEC-05,08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#495057;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="620" y="675" width="810" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="c-note" value="Architecture rule: controllers translate HTTP only; services own policy and transactions; repositories own persistence. The database remains the source of truth." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="80" y="760" width="440" height="100" as="geometry"/>
                </mxCell>
