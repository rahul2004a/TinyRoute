                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lane-auth" value="Register / sign-in / sign-out" style="swimlane;html=1;horizontal=1;startSize=32;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="cmp1">
                    <mxGeometry x="640" y="90" width="580" height="1320" as="geometry"/>
                </mxCell>
                <mxCell id="au-next" value="Next.js — forms only; no auth policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="50" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="au-ing" value="HTTPS ingress — /api/auth/*" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="130" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="au-csrf" value="CsrfProtection — mutating auth calls" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="210" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="au-ctrl" value="AuthController&#10;register / verify OTP / login / oauth / logout / me" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="290" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="au-rl" value="RateLimitService.allowAuth(clientHash)&#10;→ RateLimitStore INCR rl:auth:{clientHash}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="382" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="au-svc" value="AuthService — provider map + otpSenders map; display name; pending cookie" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="474" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="au-saf" value="SessionAuthFilter (logout / me only)&#10;reads cookie; sliding 30-day TTL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="554" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="au-users" value="UserRepository + AuthIdentityRepository + PendingRegistrationRepository" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="646" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="au-sess" value="SessionStore.create / get / touch / delete" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
                    <mxGeometry x="40" y="726" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="au-pg" value="PostgreSQL — users, auth_identities, pending_registrations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-auth">
