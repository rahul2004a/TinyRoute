                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-11" value="SQL links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-repo" target="lk-pg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-12" value="DEL redirect:{code}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-cache" target="lk-redis">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-13" value="session + rl:create" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-saf" target="lk-redis">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-14" value="INCR rl:create" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-rl" target="lk-redis">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lane-hlth" value="Health" style="swimlane;html=1;horizontal=1;startSize=32;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="cmp1">
                    <mxGeometry x="1840" y="90" width="580" height="1320" as="geometry"/>
                </mxCell>
                <mxCell id="hl-mon" value="Uptime monitor / load balancer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="50" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="hl-ing" value="HTTPS ingress — GET /actuator/health" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="130" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="hl-ctrl" value="HealthController" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="210" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="hl-repo" value="UserRepository / DataSource ping" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="290" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="hl-pg" value="PostgreSQL — required for UP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="370" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="hl-redis" value="Redis — optional; loss must not mark app down" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fontSize=13;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="450" width="500" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="hl-note" value="Does not call: Auth/Link/Redirect services, rate limits, CSRF, sessions. Redis down degrades cache/sessions but health stays UP if PostgreSQL answers (NFR-AVL-02)." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=12;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="530" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="hl-matrix" value="Shared instances (one each): PostgreSQL, Redis, RateLimitService, RedirectCache, SessionStore, LinkRepository. Columns show the same beans, not separate copies. Cross-column rule: LinkService evicts the same RedirectCache that RedirectService reads." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=12;" vertex="1" parent="lane-hlth">
                    <mxGeometry x="40" y="670" width="500" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="he-1" value="GET /actuator/health" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-hlth" source="hl-mon" target="hl-ing">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-hlth" source="hl-ing" target="hl-ctrl">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he-3" value="required ping" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-hlth" source="hl-ctrl" target="hl-repo">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he-4" value="SELECT 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-hlth" source="hl-repo" target="hl-pg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he-5" value="optional PING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="lane-hlth" source="hl-ctrl" target="hl-redis">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cmp-foot" value="Layer reminder: controllers translate HTTP only → services own policy/transactions → repositories/adapters own PostgreSQL/Redis. Ownership is never enforced in Next.js (FR-MGT-02, NFR-SEC-04)." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=13;" vertex="1" parent="cmp1">
                    <mxGeometry x="40" y="1430" width="2380" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="data" name="3 - Data and Redis Keys">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="d0"/>
                <mxCell id="d1" parent="d0"/>
                <mxCell id="d-title" value="TinyRoute LLD — PostgreSQL Schema and Redis Keyspace" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="d1">
                    <mxGeometry x="280" y="20" width="980" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="d-pg" value="PostgreSQL — system of record" style="swimlane;html=1;horizontal=1;startSize=35;fontSize=16;fontStyle=1;collapsible=0;" vertex="1" parent="d1">
                    <mxGeometry x="40" y="80" width="980" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="d-users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt; UUID PK&lt;br&gt;&lt;b&gt;email_normalized&lt;/b&gt; VARCHAR UNIQUE NOT NULL&lt;br&gt;password_hash VARCHAR NOT NULL&lt;br&gt;created_at TIMESTAMPTZ NOT NULL&lt;br&gt;updated_at TIMESTAMPTZ NOT NULL&lt;br&gt;&lt;br&gt;Only email + password hash (NFR-PRV-01). No name/phone/profile." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="d-pg">
                    <mxGeometry x="30" y="55" width="430" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="d-links" value="&lt;b&gt;links&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt; UUID PK&lt;br&gt;&lt;b&gt;code&lt;/b&gt; VARCHAR UNIQUE NOT NULL (case-sensitive collation)&lt;br&gt;&lt;b&gt;owner_id&lt;/b&gt; UUID FK → users.id&lt;br&gt;destination_url TEXT NOT NULL (https; owner-editable, FR-MGT-07)&lt;br&gt;status TEXT CHECK (ACTIVE | DISABLED | DELETED)&lt;br&gt;click_count BIGINT NOT NULL DEFAULT 0 (informational; may lag ≤1 min)&lt;br&gt;created_at TIMESTAMPTZ NOT NULL&lt;br&gt;updated_at TIMESTAMPTZ NOT NULL&lt;br&gt;deleted_at TIMESTAMPTZ NULL&lt;br&gt;expires_at TIMESTAMPTZ NULL  «Should / FR-CRE-08»&lt;br&gt;&lt;br&gt;DELETED row is a tombstone; code is never reused." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="d-pg">
                    <mxGeometry x="500" y="55" width="450" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="d-indexes" value="&lt;b&gt;Indexes and constraints&lt;/b&gt;&lt;br&gt;1. UNIQUE links(code): collision-safe generation + O(log n) lookup; never UPDATE code&lt;br&gt;2. INDEX links(owner_id, created_at DESC, id DESC): stable cursor pagination&lt;br&gt;3. CHECK destination_url starts with https:// (service also validates + rejects self-host)&lt;br&gt;4. FK owner_id RESTRICT: MVP has no account deletion (FR-ACC-05 Could)&lt;br&gt;5. Parameterized JPA; every manage query includes owner_id&lt;br&gt;6. click_count updated asynchronously; not on the redirect critical path&lt;br&gt;&lt;br&gt;FR-CRE-03,04 • FR-RED-06 • FR-MGT-01,02,05,07 • FR-ANA-01" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="d-pg">
                    <mxGeometry x="30" y="400" width="920" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="d-should-tbl" value="Should tables (not required to ship Must): password_reset_tokens (token_hash, user_id, expires_at); daily_click_aggregates (link_id, day, clicks) with no visitor identifiers." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;dashed=1;fontSize=12;" vertex="1" parent="d-pg">
                    <mxGeometry x="30" y="650" width="920" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="d-rel" value="1 owner : 0..* links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d-pg" source="d-users" target="d-links">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d-redis" value="Redis — disposable acceleration / ephemeral state" style="swimlane;html=1;horizontal=1;startSize=35;fontSize=16;fontStyle=1;collapsible=0;" vertex="1" parent="d1">
                    <mxGeometry x="1060" y="80" width="500" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="d-cache" value="&lt;b&gt;redirect:{code}&lt;/b&gt;&lt;br&gt;Value: RedirectLookup {status, destination?}&lt;br&gt;TTL: ≤5 seconds for ACTIVE/DISABLED&lt;br&gt;DELETED/UNKNOWN may use short negative TTL&lt;br&gt;Evict after successful create / status / destination / delete commit&lt;br&gt;Malformed or incomplete value is a miss, never a redirect." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="d-redis">
                    <mxGeometry x="30" y="55" width="440" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="d-session" value="&lt;b&gt;session:{tokenHash}&lt;/b&gt;&lt;br&gt;Value: {userId, lastAccessAt}&lt;br&gt;Sliding idle TTL: 30 days&lt;br&gt;Browser stores opaque random token only&lt;br&gt;Logout deletes key immediately.&lt;br&gt;NFR-SEC-06" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="d-redis">
                    <mxGeometry x="30" y="270" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="d-rates" value="&lt;b&gt;Rate-limit keys&lt;/b&gt;&lt;br&gt;rl:auth:{clientHash}&lt;br&gt;rl:create:{userId}&lt;br&gt;rl:redirect:{clientHash}&lt;br&gt;Atomic INCR + EXPIRE; bounded TTL&lt;br&gt;Client IP is keyed/HMACed, never retained &amp;gt;24h.&lt;br&gt;FR-ABS-01..03 • NFR-PRV-02" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="d-redis">
                    <mxGeometry x="30" y="465" width="440" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="d-consistency" value="Consistency: database commit precedes cache eviction. A stale entry can survive no longer than its ≤5-second TTL. Redis loss degrades latency/session availability but never changes PostgreSQL truth; a PostgreSQL lookup failure returns an error and never guesses a destination. NFR-CON-01,02 • NFR-REL-02" style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=13;" vertex="1" parent="d1">
                    <mxGeometry x="40" y="870" width="1520" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="auth-create" name="4 - Auth and Create">
        <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="ac0"/>
                <mxCell id="ac1" parent="ac0"/>
                <mxCell id="ac-title" value="TinyRoute LLD — Registration, Sign-in, and Link Creation" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="ac1">
                    <mxGeometry x="280" y="20" width="980" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="ac-user" value="Browser / Next.js" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;recursiveResize=0;outlineConnect=0;fontSize=13;" vertex="1" parent="ac1">
                    <mxGeometry x="40" y="80" width="170" height="860" as="geometry"/>
                </mxCell>
                <mxCell id="ac-api" value="Spring Security + Controllers" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;recursiveResize=0;outlineConnect=0;fontSize=13;" vertex="1" parent="ac1">
                    <mxGeometry x="300" y="80" width="230" height="860" as="geometry"/>
                </mxCell>
                <mxCell id="ac-service" value="AuthService / LinkService" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;recursiveResize=0;outlineConnect=0;fontSize=13;" vertex="1" parent="ac1">
                    <mxGeometry x="620" y="80" width="230" height="860" as="geometry"/>
                </mxCell>
                <mxCell id="ac-redis" value="Redis" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;recursiveResize=0;outlineConnect=0;fontSize=13;" vertex="1" parent="ac1">
                    <mxGeometry x="950" y="80" width="130" height="860" as="geometry"/>
                </mxCell>
                <mxCell id="ac-db" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;recursiveResize=0;outlineConnect=0;fontSize=13;" vertex="1" parent="ac1">
                    <mxGeometry x="1190" y="80" width="150" height="860" as="geometry"/>
                </mxCell>
                <mxCell id="ac-note1" value="REGISTER / SIGN IN — FR-ACC-01..03, FR-ABS-02, NFR-SEC-02/06" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="ac1">
                    <mxGeometry x="50" y="140" width="620" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="ac-e1" value="1. POST /api/auth/register or /login" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="125" y="200" as="sourcePoint"/>
                        <mxPoint x="415" y="200" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e2" value="2. check rl:auth:{clientHash}" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="415" y="255" as="sourcePoint"/>
                        <mxPoint x="1015" y="255" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e3" value="3. normalize email; hash or verify password" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="415" y="310" as="sourcePoint"/>
                        <mxPoint x="735" y="310" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e4" value="4. insert / find user by email_normalized" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="735" y="365" as="sourcePoint"/>
                        <mxPoint x="1265" y="365" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e5" value="5. create opaque session; sliding 30-day TTL" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="735" y="420" as="sourcePoint"/>
                        <mxPoint x="1015" y="420" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e6" value="6. Set-Cookie: HttpOnly; Secure; SameSite" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="415" y="475" as="sourcePoint"/>
                        <mxPoint x="125" y="475" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-note2" value="CREATE LINK — FR-CRE-01..06, FR-ABS-01, NFR-CON-01" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="ac1">
                    <mxGeometry x="50" y="505" width="640" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="ac-e7" value="7. POST /api/links {destinationUrl} + CSRF" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="125" y="560" as="sourcePoint"/>
                        <mxPoint x="415" y="560" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e8" value="8. resolve session + rl:create:{userId}" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="415" y="615" as="sourcePoint"/>
                        <mxPoint x="1015" y="615" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e9" value="9. validate https + reject TinyRoute self-host" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="415" y="670" as="sourcePoint"/>
                        <mxPoint x="735" y="670" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e10" value="10. INSERT generated code; retry only on unique conflict" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="735" y="725" as="sourcePoint"/>
                        <mxPoint x="1265" y="725" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e11" value="11. after commit: DEL redirect:{code}" style="endArrow=block;html=1;rounded=0;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="735" y="780" as="sourcePoint"/>
                        <mxPoint x="1015" y="780" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-e12" value="12. 201 {code, shortUrl}; UI one-click copy" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="ac1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="415" y="835" as="sourcePoint"/>
                        <mxPoint x="125" y="835" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-errors" value="Error branches: 401 signed out • 403 CSRF failure • 400 invalid/non-HTTPS/self-reference • 409 only after bounded code-generation retries • 429 rate limited with retry guidance • 5xx safe generic error. Never overwrite an existing code." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=13;" vertex="1" parent="ac1">
                    <mxGeometry x="80" y="960" width="1400" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="redirect" name="5 - Public Redirect">
        <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="r0"/>
                <mxCell id="r1" parent="r0"/>
                <mxCell id="r-title" value="TinyRoute LLD — Public Redirect (cache-aside, fail-closed)" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="r1">
                    <mxGeometry x="280" y="16" width="1100" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="r-start" value="GET /{code}&#xa;No authentication" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="60" y="90" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r-valid" value="Code format valid and&#xa;redirect rate limit allowed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="320" y="75" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-cache" value="Redis redirect:{code}&#xa;well-formed cached state?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="630" y="75" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-db" value="SELECT by exact, case-sensitive code&#xa;from PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="950" y="90" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r-dbok" value="Query completed with&#xa;known row or known absence?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="1290" y="75" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-state" value="Resolved state" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="660" y="320" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="r-active" value="ACTIVE + destination present&#xa;(and not past expiresAt if set)&#xa;Return 302/307 Location exactly as stored&#xa;Preserves path / query / fragment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="80" y="540" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-click" value="ClickCountService.recordSuccessfulRedirect (async)&#xa;Must not block or change the 3xx. No visitor IP/id." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fontSize=12;" vertex="1" parent="r1">
                    <mxGeometry x="80" y="680" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="r-disabled" value="DISABLED&#xa;Return unavailable page&#xa;No owner / destination details" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="460" y="540" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-missing" value="UNKNOWN or DELETED&#xa;(or expired, if expiresAt set)&#xa;Return not-found / unavailable&#xa;Reveal no original-link details" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="770" y="540" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-error" value="UNKNOWN SYSTEM STATE&#xa;Return safe 5xx error&#xa;Never redirect (fail closed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;" vertex="1" parent="r1">
                    <mxGeometry x="1120" y="540" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-cachewrite" value="On DB success, cache complete RedirectLookup with TTL ≤5 s. Cache write failures do not fail the request. Malformed cache entries are misses, never redirect instructions." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="980" y="280" width="480" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="r-target" value="Targets: p95 &amp;lt;150 ms, p99 &amp;lt;300 ms at 100 rps; &amp;lt;0.5% errors. Correctness dominates availability: only a complete known ACTIVE record with a destination can redirect. FR-RED-01..06 • NFR-PER-01,03 • NFR-REL-01,02. Datastore uncertainty → fail closed." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=13;" vertex="1" parent="r1">
                    <mxGeometry x="80" y="800" width="1480" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-start" target="r-valid">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-valid" target="r-cache">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re3" value="invalid → 404; limited → 429" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-valid" target="r-missing">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re4" value="hit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-cache" target="r-state">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re5" value="miss / Redis unavailable / malformed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-cache" target="r-db">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re6" value="yes: row or absence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-dbok" target="r-state">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re7" value="timeout / error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-dbok" target="r-error">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-db" target="r-dbok">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re9" value="ACTIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-active">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re10" value="DISABLED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-disabled">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re11" value="DELETED / absent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-missing">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re12" value="incomplete / uncertain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-error">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="r1" source="r-active" target="r-click">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="management" name="6 - Manage Lifecycle">
        <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
            <root>
                <mxCell id="m0"/>
                <mxCell id="m1" parent="m0"/>
                <mxCell id="m-title" value="TinyRoute LLD — Owner List, Disable, Re-enable, Delete, Edit Destination" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="m1">
                    <mxGeometry x="180" y="16" width="1300" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="m-request" value="Authenticated request&#xa;Secure session + CSRF&#xa;Link identifier / cursor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="60" y="90" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m-session" value="Resolve Redis session&#xa;to userId" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="370" y="80" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m-action" value="Operation" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="680" y="85" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m-list" value="LIST&#xa;SELECT WHERE owner_id = :userId&#xa;ORDER BY created_at DESC, id DESC&#xa;cursor pagination; include status + clickCount" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="80" y="280" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m-lock" value="COMMAND&#xa;SELECT link by id AND owner_id&#xa;inside transaction&#xa;No separate unscoped lookup" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="500" y="280" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m-transition" value="Requested transition" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="920" y="275" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m-disable" value="ACTIVE → DISABLED&#xa;DISABLED → DISABLED is success" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="80" y="520" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="m-enable" value="DISABLED → ACTIVE&#xa;ACTIVE → ACTIVE is success" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="400" y="520" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="m-delete" value="Any non-deleted → DELETED tombstone&#xa;Repeated delete: same end state&#xa;Code remains reserved forever" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="720" y="510" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m-edit" value="EDIT DESTINATION (FR-MGT-07)&#xa;Validate https + reject self-host&#xa;Replace destination_url; future redirects use it&#xa;Code unchanged" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="1080" y="500" width="360" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m-evict" value="After successful DB commit: DEL redirect:{code}. TTL ≤5 seconds bounds stale state if eviction fails. Return the same resource end state for retries (NFR-REL-03)." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="500" y="700" width="940" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="m-errors" value="401 invalid session • 403 CSRF failure • 404 for missing or non-owned resource (no ownership oracle) • 400 invalid destination • safe 5xx on datastore uncertainty. Every write checks owner_id in the persistence operation. FR-MGT-01..05, FR-MGT-07 • NFR-SEC-04 • NFR-REL-03 • NFR-CON-02." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=13;" vertex="1" parent="m1">
                    <mxGeometry x="80" y="820" width="1360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-request" target="m-session">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me2" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-session" target="m-action">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me3" value="GET /api/links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-action" target="m-list">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me4" value="PATCH / DELETE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-action" target="m-lock">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me5" value="owned row" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-lock" target="m-transition">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me6" value="disable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-transition" target="m-disable">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me7" value="enable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-transition" target="m-enable">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me8" value="delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-transition" target="m-delete">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me12" value="destination" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-transition" target="m-edit">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-disable" target="m-evict">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-enable" target="m-evict">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-delete" target="m-evict">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-edit" target="m-evict">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="api-growth" name="7 - API and Growth">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="g0"/>
                <mxCell id="g1" parent="g0"/>
                <mxCell id="g-title" value="TinyRoute LLD — MVP HTTP Boundary and V1/Growth Extensions" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="g1">
                    <mxGeometry x="220" y="16" width="1160" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="g-api" value="MVP HTTP boundary" style="swimlane;html=1;horizontal=1;startSize=40;fontSize=16;fontStyle=1;collapsible=0;" vertex="1" parent="g1">
                    <mxGeometry x="40" y="70" width="740" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="g-public" value="&lt;b&gt;Public&lt;/b&gt;&lt;br&gt;GET /{code} → 3xx only for known ACTIVE with destination; otherwise safe 404 / unavailable / 5xx&lt;br&gt;GET /actuator/health → process + datastore (monitor-safe)&lt;br&gt;&lt;br&gt;No public create/manage API in MVP. Next.js is a client of these routes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="g-api">
                    <mxGeometry x="30" y="60" width="680" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="g-auth" value="&lt;b&gt;Session API&lt;/b&gt;&lt;br&gt;POST /api/auth/register {email,password} → 201 + secure cookie&lt;br&gt;POST /api/auth/login {email,password} → 204 + secure cookie&lt;br&gt;POST /api/auth/logout → 204 + revoke session&lt;br&gt;GET /api/auth/me → minimal signed-in state&lt;br&gt;&lt;br&gt;Auth endpoints are client-rate-limited; mutating calls require CSRF." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="g-api">
                    <mxGeometry x="30" y="230" width="680" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="g-links" value="&lt;b&gt;Owner link API&lt;/b&gt;&lt;br&gt;POST /api/links {destinationUrl} → 201 {id,code,shortUrl,status,createdAt}&lt;br&gt;GET /api/links?cursor=&amp;amp;limit= → owner-scoped page (code, destination, status, createdAt, clickCount)&lt;br&gt;PATCH /api/links/{id}/status {status: ACTIVE|DISABLED} → resource state&lt;br&gt;PATCH /api/links/{id}/destination {destinationUrl} → resource state (FR-MGT-07)&lt;br&gt;DELETE /api/links/{id} → 204; permanent tombstone&lt;br&gt;&lt;br&gt;401 unauthenticated • 404 missing/not owned • 409 bounded code collision exhaustion • 429 limited • safe 5xx." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="g-api">
                    <mxGeometry x="30" y="440" width="680" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="g-growth" value="V1 / 10× growth — explicitly outside MVP Must" style="swimlane;html=1;horizontal=1;startSize=40;fontSize=16;fontStyle=1;collapsible=0;dashed=1;" vertex="1" parent="g1">
                    <mxGeometry x="820" y="70" width="740" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="g-v1" value="&lt;b&gt;Should / V1 feature extensions&lt;/b&gt;&lt;br&gt;• Password reset + email provider (FR-ACC-04)&lt;br&gt;• Custom aliases, expiry-at-create, search (FR-CRE-07/08, FR-MGT-06)&lt;br&gt;• Destination blocklist and API keys (V1, FR-ABS-04, FR-API-01..03)&lt;br&gt;• Daily click aggregates (FR-ANA-03); still no visitor IP/id&lt;br&gt;• Metrics, error tracking, audit events, uptime alerts&lt;br&gt;&lt;br&gt;Each is an additive module/migration. None sits on the MVP redirect critical path. Safe-browsing is Future." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;dashed=1;" vertex="1" parent="g-growth">
                    <mxGeometry x="30" y="60" width="680" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="g-scale" value="&lt;b&gt;Measured 10× traffic path (NFR-SCL-03)&lt;/b&gt;&lt;br&gt;1. Keep Spring Boot stateless except shared Redis sessions.&lt;br&gt;2. Add application instances behind existing ingress; rolling health-checked deploys.&lt;br&gt;3. Keep shared Redis and PostgreSQL; tune pools and indexes from load-test evidence.&lt;br&gt;4. Add Redis HA/managed tier and PostgreSQL read replica only if measured bottlenecks justify them.&lt;br&gt;5. Partition/queue analytics writes before changing redirect storage.&lt;br&gt;&lt;br&gt;No multi-region or active/active design; this remains a modest single-region service." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;dashed=1;" vertex="1" parent="g-growth">
                    <mxGeometry x="30" y="330" width="680" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="g-scope" value="MVP Must: accounts, HTTPS-only create, unique codes, public redirect (unknown/disabled/deleted/fail-closed), owner-only list/disable/re-enable/delete/edit destination, click counts (async), auth/create rate limits, health, backups, logs, CI, migrations. MVP Should (not in core class model unless labeled): session persistence, password reset, self-host rejection, custom alias, expiry, search, 30-day click trend, redirect throttle. Excluded: public API keys, blocklist, social login, admin console, safe-browsing." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=13;" vertex="1" parent="g1">
                    <mxGeometry x="40" y="860" width="1520" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
