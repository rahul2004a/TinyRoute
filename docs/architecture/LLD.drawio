                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="le-5" value="create only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-link" source="lk-ctrl" target="lk-rl">
                    <mxGeometry relative="1" as="geometry"/>
