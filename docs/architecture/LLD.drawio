    <diagram id="data" name="2 - Data and Redis Keys">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="d0"/>
                <mxCell id="d1" parent="d0"/>
                <mxCell id="d-title" value="TinyRoute LLD — PostgreSQL Schema and Redis Keyspace" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="d1">
                    <mxGeometry x="430" y="20" width="740" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="d-pg" value="PostgreSQL — system of record" style="swimlane;html=1;horizontal=1;startSize=35;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="d1">
                    <mxGeometry x="50" y="90" width="950" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="d-users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt; UUID PK&lt;br&gt;&lt;b&gt;email_normalized&lt;/b&gt; VARCHAR UNIQUE NOT NULL&lt;br&gt;password_hash VARCHAR NOT NULL&lt;br&gt;created_at TIMESTAMPTZ NOT NULL&lt;br&gt;updated_at TIMESTAMPTZ NOT NULL&lt;br&gt;&lt;br&gt;Only email + password hash (NFR-PRV-01)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="d-pg">
                    <mxGeometry x="45" y="80" width="360" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="d-links" value="&lt;b&gt;links&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt; UUID PK&lt;br&gt;&lt;b&gt;code&lt;/b&gt; VARCHAR UNIQUE NOT NULL (binary/case-sensitive collation)&lt;br&gt;&lt;b&gt;owner_id&lt;/b&gt; UUID FK → users.id&lt;br&gt;destination_url TEXT NOT NULL, immutable in MVP&lt;br&gt;status ENUM ACTIVE | DISABLED | DELETED&lt;br&gt;created_at TIMESTAMPTZ NOT NULL&lt;br&gt;updated_at TIMESTAMPTZ NOT NULL&lt;br&gt;deleted_at TIMESTAMPTZ NULL&lt;br&gt;&lt;br&gt;DELETED row is a tombstone; code is never reused." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="d-pg">
                    <mxGeometry x="505" y="80" width="390" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="d-indexes" value="&lt;b&gt;Indexes and constraints&lt;/b&gt;&lt;br&gt;1. UNIQUE links(code): collision-safe generation + O(log n) lookup&lt;br&gt;2. INDEX links(owner_id, created_at DESC, id DESC): stable cursor pagination&lt;br&gt;3. CHECK destination scheme is https (service also validates)&lt;br&gt;4. FK owner_id RESTRICT: MVP has no account deletion&lt;br&gt;5. Parameterized JPA queries; ownership query includes owner_id&lt;br&gt;&lt;br&gt;FR-CRE-03,04 • FR-RED-06 • FR-MGT-01,02,05" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="d-pg">
                    <mxGeometry x="45" y="420" width="850" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="d-rel" value="1 owner : N links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d-pg" source="d-users" target="d-links">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d-redis" value="Redis — disposable acceleration/state" style="swimlane;html=1;horizontal=1;startSize=35;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;" vertex="1" parent="d1">
                    <mxGeometry x="1050" y="90" width="490" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="d-cache" value="&lt;b&gt;redirect:{code}&lt;/b&gt;&lt;br&gt;Value: {status, destination?}&lt;br&gt;TTL: ≤5 seconds for ACTIVE/DISABLED&lt;br&gt;DELETED/UNKNOWN may use short negative TTL&lt;br&gt;Evict after successful create/status/delete commit&lt;br&gt;No redirect when value is incomplete or malformed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;" vertex="1" parent="d-redis">
                    <mxGeometry x="35" y="70" width="420" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="d-session" value="&lt;b&gt;session:{randomTokenHash}&lt;/b&gt;&lt;br&gt;Value: {userId, lastAccessAt}&lt;br&gt;Sliding idle TTL: 30 days&lt;br&gt;Browser stores opaque random token only&lt;br&gt;Logout deletes key immediately.&lt;br&gt;NFR-SEC-06" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;" vertex="1" parent="d-redis">
                    <mxGeometry x="35" y="270" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="d-rates" value="&lt;b&gt;Rate-limit keys&lt;/b&gt;&lt;br&gt;rl:auth:{clientHash}:{window}&lt;br&gt;rl:create:{userId}:{window}&lt;br&gt;rl:redirect:{clientHash}:{window}&lt;br&gt;Atomic INCR + EXPIRE; bounded TTL&lt;br&gt;Client IP is keyed/HMACed, never retained &gt;24h.&lt;br&gt;FR-ABS-01..03 • NFR-PRV-02" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;" vertex="1" parent="d-redis">
                    <mxGeometry x="35" y="450" width="420" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="d-consistency" value="Consistency: database commit precedes cache eviction. A stale entry can survive no longer than its ≤5-second TTL. Redis loss degrades latency/session availability but never changes the PostgreSQL truth; a PostgreSQL lookup failure returns an error and never guesses a destination. NFR-CON-01,02 • NFR-REL-02" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="d1">
                    <mxGeometry x="210" y="830" width="1180" height="100" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
