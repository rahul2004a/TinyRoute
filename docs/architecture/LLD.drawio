                <mxCell id="AuthIdentity" value="&lt;b&gt;[C] AuthIdentity&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;- id: UUID&lt;br&gt;- user: User&lt;br&gt;- provider: AuthProviderType&lt;br&gt;- subject: String&lt;br&gt;- secretHash: String?&lt;br&gt;- createdAt: Instant&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;secretHash NOT NULL iff PASSWORD&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fillColor=#000000;fontColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="c1">
                    <mxGeometry x="40" y="1610" width="275" height="191" as="geometry"/>
                </mxCell>
                <mxCell id="PendingRegistration" value="&lt;b&gt;[C] PendingRegistration&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;- id: UUID&lt;br&gt;- tokenHash: String&lt;br&gt;- emailNormalized: String&lt;br&gt;- displayName: String&lt;br&gt;- passwordHash: String&lt;br&gt;- otpHash: String&lt;br&gt;- expiresAt: Instant&lt;br&gt;- attempts: int&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;OTP + display name live here, not on AuthIdentity&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fillColor=#000000;fontColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="c1">
                    <mxGeometry x="40" y="1825" width="275" height="242" as="geometry"/>
                </mxCell>
                <mxCell id="auth-not-add" value="What not to add: OTP or display name on AuthIdentity (OTP → PendingRegistration; name → User). passwordAuthProvider / googleAuthProvider fields on AuthService (use providers map). Google tokens in PostgreSQL (in-memory callback; persist sub only). Email on VerifyOtpRequest (pending cookie). smsSender field on AuthService (otpSenders map + SmsOtpSender later)." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#000000;fontColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="c1">
                    <mxGeometry x="2260" y="1550" width="720" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="auth-cookie-note" value="Cookies: register → pending_registration; verifyRegister → session and clear pending; oauthStart → oauth_state; oauthCallback / login → session. Verify UI is OTP only." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#000000;fontColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="c1">
                    <mxGeometry x="2260" y="1710" width="720" height="80" as="geometry"/>
                </mxCell>
