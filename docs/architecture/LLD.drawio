                <mxCell id="re-3" value="1. throttle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="lane-red" source="red-ctrl" target="red-rl">
                    <mxGeometry relative="1" as="geometry"/>
