                    </mxGeometry>
                </mxCell>
                <mxCell id="ac-errors" value="Error branches: 401 signed out • 403 CSRF failure • 400 invalid/non-HTTPS/self-reference • 409 only after bounded code-generation retries • 429 rate limited with retry guidance • 5xx safe generic error. Never overwrite an existing code." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="ac1">
                    <mxGeometry x="170" y="965" width="1160" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="redirect" name="4 - Public Redirect">
        <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
            <root>
                <mxCell id="r0"/>
                <mxCell id="r1" parent="r0"/>
                <mxCell id="r-title" value="TinyRoute LLD — Public Redirect Fast Path" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="r1">
                    <mxGeometry x="450" y="20" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r-start" value="GET /{code}&lt;br&gt;No authentication" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="r1">
                    <mxGeometry x="80" y="110" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r-valid" value="Code format valid and&lt;br&gt;redirect rate limit allowed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="340" y="95" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-cache" value="Redis redirect:{code}&lt;br&gt;well-formed cached state?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="650" y="95" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-db" value="SELECT by exact, case-sensitive code&lt;br&gt;from PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="970" y="110" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r-dbok" value="Query completed with&lt;br&gt;known row/absence?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="1290" y="95" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-state" value="Resolved state" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="r1">
                    <mxGeometry x="675" y="335" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="r-active" value="ACTIVE + destination present&lt;br&gt;Return 302/307 Location exactly as stored&lt;br&gt;Preserves path/query/fragment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#2b8a3e;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="180" y="560" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-disabled" value="DISABLED&lt;br&gt;Return unavailable page&lt;br&gt;No owner/destination details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="540" y="560" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-missing" value="UNKNOWN or DELETED&lt;br&gt;Return not-found/unavailable response&lt;br&gt;Reveal no original-link details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#495057;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="850" y="560" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-error" value="UNKNOWN SYSTEM STATE&lt;br&gt;Return safe 5xx error&lt;br&gt;Never redirect (fail closed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffc9c9;strokeColor=#c92a2a;fontSize=14;fontStyle=1;" vertex="1" parent="r1">
                    <mxGeometry x="1190" y="560" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="r-cachewrite" value="On DB success, cache complete state with TTL ≤5 s. Cache failures do not fail the request. Malformed cache entries are misses, never redirect instructions." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="900" y="300" width="460" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="r-target" value="Targets: p95 &lt;150 ms, p99 &lt;300 ms at 100 rps; &lt;0.5% errors. Correctness dominates availability: only a complete ACTIVE record can redirect. FR-RED-01..06 • NFR-PER-01,03 • NFR-REL-01,02." style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="r1">
                    <mxGeometry x="260" y="790" width="1080" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-start" target="r-valid">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-valid" target="r-cache">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re3" value="invalid → 404; limited → 429" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-valid" target="r-missing">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re4" value="hit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-cache" target="r-state">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re5" value="miss / Redis unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-cache" target="r-db">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re6" value="yes: row or absence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-dbok" target="r-state">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re7" value="timeout/error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#c92a2a;" edge="1" parent="r1" source="r-dbok" target="r-error">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-db" target="r-dbok">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re9" value="ACTIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2b8a3e;" edge="1" parent="r1" source="r-state" target="r-active">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re10" value="DISABLED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-disabled">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re11" value="DELETED / absent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-missing">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re12" value="incomplete/malformed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#c92a2a;" edge="1" parent="r1" source="r-state" target="r-error">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="management" name="5 - Manage Lifecycle">
        <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
            <root>
                <mxCell id="m0"/>
                <mxCell id="m1" parent="m0"/>
                <mxCell id="m-title" value="TinyRoute LLD — Owner List, Disable, Re-enable, and Delete" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="m1">
                    <mxGeometry x="340" y="20" width="920" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="m-request" value="Authenticated request&lt;br&gt;Secure session + CSRF&lt;br&gt;Link identifier / cursor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="80" y="120" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m-session" value="Resolve Redis session&lt;br&gt;to userId" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="390" y="115" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m-action" value="Operation" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="m1">
                    <mxGeometry x="690" y="120" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m-list" value="LIST&lt;br&gt;SELECT WHERE owner_id=:userId&lt;br&gt;ORDER BY created_at DESC, id DESC&lt;br&gt;cursor pagination; include status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="220" y="390" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m-lock" value="COMMAND&lt;br&gt;SELECT link by id AND owner_id&lt;br&gt;inside transaction&lt;br&gt;No separate unscoped lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="640" y="390" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m-transition" value="Requested transition" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="1050" y="395" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m-disable" value="ACTIVE → DISABLED&lt;br&gt;DISABLED → DISABLED is success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="560" y="650" width="250" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m-enable" value="DISABLED → ACTIVE&lt;br&gt;ACTIVE → ACTIVE is success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#2b8a3e;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="850" y="650" width="250" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m-delete" value="Any non-deleted → DELETED tombstone&lt;br&gt;Clear destination after policy permits&lt;br&gt;Repeated delete reaches same end state&lt;br&gt;Code remains reserved forever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffc9c9;strokeColor=#c92a2a;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="1140" y="630" width="300" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m-evict" value="After successful DB commit: DEL redirect:{code}. TTL ≤5 seconds bounds stale state if eviction fails. Return the same resource end state for retries." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="590" y="830" width="800" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m-errors" value="401 invalid session • 403 CSRF failure • 404 for missing or non-owned resource (no ownership oracle) • safe 5xx on datastore uncertainty. Every write checks owner_id in the persistence operation. FR-MGT-01..05 • NFR-SEC-04 • NFR-REL-03 • NFR-CON-02." style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="m1">
                    <mxGeometry x="100" y="830" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-request" target="m-session">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me2" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-session" target="m-action">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me3" value="GET /api/links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-action" target="m-list">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me4" value="PATCH / DELETE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-action" target="m-lock">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me5" value="owned row" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-lock" target="m-transition">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me6" value="disable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-transition" target="m-disable">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me7" value="enable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-transition" target="m-enable">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me8" value="delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-transition" target="m-delete">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-disable" target="m-evict">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-enable" target="m-evict">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="me11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-delete" target="m-evict">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="api-growth" name="6 - API and Growth">
        <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="g0"/>
                <mxCell id="g1" parent="g0"/>
                <mxCell id="g-title" value="TinyRoute LLD — MVP HTTP Boundary and V1/Growth Extensions" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="g1">
                    <mxGeometry x="340" y="20" width="920" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="g-api" value="MVP HTTP boundary" style="swimlane;html=1;horizontal=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="g1">
                    <mxGeometry x="60" y="100" width="700" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="g-public" value="&lt;b&gt;Public&lt;/b&gt;&lt;br&gt;GET /{code} → 3xx only for ACTIVE; otherwise safe 404/unavailable/5xx&lt;br&gt;GET /actuator/health → service + datastore health (monitor-safe)&lt;br&gt;&lt;br&gt;No public create/manage API in MVP." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="g-api">
                    <mxGeometry x="35" y="70" width="630" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="g-auth" value="&lt;b&gt;Session API&lt;/b&gt;&lt;br&gt;POST /api/auth/register {email,password} → 201 + secure cookie&lt;br&gt;POST /api/auth/login {email,password} → 204 + secure cookie&lt;br&gt;POST /api/auth/logout → 204 + revoke session&lt;br&gt;GET /api/auth/me → minimal signed-in state&lt;br&gt;&lt;br&gt;Auth endpoints are client-rate-limited; mutating calls require CSRF protection." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="g-api">
                    <mxGeometry x="35" y="250" width="630" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="g-links" value="&lt;b&gt;Owner link API&lt;/b&gt;&lt;br&gt;POST /api/links {destinationUrl} → 201 {id,code,shortUrl,status,createdAt}&lt;br&gt;GET /api/links?cursor=&amp;limit= → owner-scoped page&lt;br&gt;PATCH /api/links/{id}/status {status: ACTIVE|DISABLED} → resource state&lt;br&gt;DELETE /api/links/{id} → 204; permanent tombstone&lt;br&gt;&lt;br&gt;401 unauthenticated • 404 missing/not owned • 409 bounded code collision exhaustion • 429 limited • safe 5xx." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="g-api">
                    <mxGeometry x="35" y="460" width="630" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="g-growth" value="V1 / 10× growth — explicitly outside MVP" style="swimlane;html=1;horizontal=1;startSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;fontStyle=1;dashed=1;" vertex="1" parent="g1">
                    <mxGeometry x="820" y="100" width="720" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="g-v1" value="&lt;b&gt;V1 feature extensions&lt;/b&gt;&lt;br&gt;• Password reset + email provider&lt;br&gt;• Custom aliases, expiry, search, blocklist&lt;br&gt;• API keys and public create/manage API&lt;br&gt;• Anonymous click event → queue/stream → worker → daily aggregates (≤1 minute lag)&lt;br&gt;• Metrics, error tracking, audit events, uptime alerts&lt;br&gt;&lt;br&gt;Each is an additive module/migration; none sits on the MVP redirect critical path." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;dashed=1;" vertex="1" parent="g-growth">
                    <mxGeometry x="35" y="70" width="650" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="g-scale" value="&lt;b&gt;Measured 10× traffic path&lt;/b&gt;&lt;br&gt;1. Keep Spring Boot stateless except shared Redis sessions.&lt;br&gt;2. Add application instances behind existing ingress; rolling health-checked deploys.&lt;br&gt;3. Keep shared Redis and PostgreSQL; tune pools and indexes from load-test evidence.&lt;br&gt;4. Add Redis HA/managed tier and PostgreSQL read replica only if measured bottlenecks justify them.&lt;br&gt;5. Partition/queue analytics writes before changing redirect storage.&lt;br&gt;&lt;br&gt;No multi-region or active/active design; this remains a modest single-region service." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;dashed=1;" vertex="1" parent="g-growth">
                    <mxGeometry x="35" y="340" width="650" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="g-scope" value="MVP scope guardrail: accounts, create, redirect, owner-only list/disable/re-enable/delete, auth/create rate limits, redirect throttle, health, backups, logs, CI, migrations. Excluded from MVP: custom aliases, expiration, analytics, public API, password reset, blocklist, social login, admin console." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="g1">
                    <mxGeometry x="180" y="850" width="1240" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>