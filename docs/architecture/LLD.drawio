                </mxCell>
                <mxCell id="lk-note" value="Does not call: AuthService, UserRepository (except via session userId), RedirectService, ClickCountService. UI never checks owner_id." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=12;" vertex="1" parent="lane-link">
                    <mxGeometry x="40" y="1024" width="500" height="80" as="geometry"/>
