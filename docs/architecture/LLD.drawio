                <mxCell id="c-note" value="Next.js is an HTTP client only. Controllers translate HTTP; services own policy/transactions; interfaces isolate JPA and Redis implementations." style="text;html=1;fontSize=12;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="c1">
