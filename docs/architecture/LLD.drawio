                <mxCell id="au-note" value="Does not call: LinkService, RedirectService, LinkRepository, RedirectCache, OwnershipGuard. Register/login have no prior session." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=12;" vertex="1" parent="lane-auth">
