# Docker Compose development infrastructure
POSTGRES_DB=tinyroute
POSTGRES_USER=tinyroute
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Spring profile and local HTTPS
SPRING_PROFILES_ACTIVE=dev
DEV_TLS_CERTIFICATE=file:../.local-certs/localhost.pem
DEV_TLS_PRIVATE_KEY=file:../.local-certs/localhost-key.pem
ALLOWED_FRONTEND_ORIGINS=https://localhost:3000

# Authentication security. Replace the key placeholders with generated PKCS#8
# private-key and X.509 public-key DER values, each encoded as one base64 line.
TINYROUTE_JWT_ISSUER=https://localhost:8443
TINYROUTE_JWT_AUDIENCE=tinyroute-local-frontend
TINYROUTE_JWT_ACTIVE_KEY_ID=localdev
TINYROUTE_JWT_SIGNING_PRIVATE_KEY_BASE64=replace-with-generated-pkcs8-base64
TINYROUTE_JWT_ACTIVE_VERIFICATION_PUBLIC_KEY_BASE64=replace-with-generated-x509-base64
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Leave unset for direct local browser-to-backend traffic. Production must set
# this to the actual Caddy peer address on the VPS ingress network, using a
# narrow /32 (IPv4) or /128 (IPv6). See infra/vps/.env.example.

# Mail. Port 1025 is a conventional developer SMTP listener; Compose does not
# start one. Point these values at a separately managed local SMTP service.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
REGISTRATION_MAIL_FROM=no-reply@tinyroute.local
PASSWORD_RESET_CONFIRMATION_URI=https://localhost:3000/password-reset/confirm

# Google OAuth local application registration
GOOGLE_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-google-client-secret
GOOGLE_REDIRECT_URI=https://localhost:8443/api/auth/google/callback
GOOGLE_SUCCESS_URI=https://localhost:3000/links
GOOGLE_FAILURE_URI=https://localhost:3000/login?error=oauth_failed

# Production-only names (safe placeholders; do not deploy this local file).
# The independent Hostinger VPS example is infra/vps/.env.example.
SERVER_PORT=8080
DATABASE_URL='jdbc:postgresql://supabase-postgres.example.invalid:5432/postgres?sslmode=verify-full&sslrootcert=/run/tinyroute/supabase-ca.crt'
DATABASE_USERNAME=replace-with-supabase-database-role
DATABASE_PASSWORD=replace-with-production-database-password
REDIS_HOST=redis
