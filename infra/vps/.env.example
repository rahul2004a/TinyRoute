# Planned Hostinger VPS backend runtime environment. Safe placeholders only.
# Not a deployable stack. Populate /etc/tinyroute/backend.env outside Git.
# This is a container env-file, not a shell script; do not source it.
# Copy the actual Supabase direct/session JDBC host and role from Connect.
# Mount the matching CA certificate read-only at the path in DATABASE_URL.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://supabase-postgres.example.invalid:5432/postgres?sslmode=verify-full&sslrootcert=/run/tinyroute/supabase-ca.crt
DATABASE_USERNAME=replace-with-supabase-database-role
DATABASE_PASSWORD=replace-with-production-supabase-database-password
# Direct host/role depends on the project; session roles also include its ref.
# Use port 5432 (direct/session), not the transaction pooler as the JPA source.
REDIS_HOST=redis
REDIS_PORT=6379
# Standard Spring property; configure the Redis server with the matching secret.
SPRING_DATA_REDIS_PASSWORD=replace-with-generated-production-redis-password

# Replace all hosts with subdomains of the same registered production domain.
ALLOWED_FRONTEND_ORIGINS=https://app.example.invalid
# Example Caddy IP only: pin/verify its actual address on the ingress network.
# Do not trust the whole private address space or enable global forwarded-header
# processing; ClientAddressResolver needs the real servlet peer address.
TRUSTED_PROXY_CIDRS=172.30.10.2/32
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes

TINYROUTE_JWT_ISSUER=https://api.example.invalid
TINYROUTE_JWT_AUDIENCE=tinyroute-production-frontend
TINYROUTE_JWT_ACTIVE_KEY_ID=replace-with-production-key-id
TINYROUTE_JWT_SIGNING_PRIVATE_KEY_BASE64=replace-with-generated-pkcs8-base64
TINYROUTE_JWT_ACTIVE_VERIFICATION_PUBLIC_KEY_BASE64=replace-with-generated-x509-base64

MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USERNAME=replace-with-production-smtp-user
MAIL_PASSWORD=replace-with-production-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
REGISTRATION_MAIL_FROM=no-reply@example.invalid
PASSWORD_RESET_CONFIRMATION_URI=https://app.example.invalid/password-reset/confirm

GOOGLE_CLIENT_ID=replace-with-production-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-production-google-client-secret
GOOGLE_REDIRECT_URI=https://api.example.invalid/api/auth/google/callback
GOOGLE_SUCCESS_URI=https://app.example.invalid/links
GOOGLE_FAILURE_URI=https://app.example.invalid/login?error=oauth_failed

# Standard Actuator properties for the future private watchdog and release gate.
# Caddy must not expose these probe paths or component details publicly.
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db,redis
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
